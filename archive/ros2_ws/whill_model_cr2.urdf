<?xml version="1.0"?>
<robot name="whill_model_cr2">

    <link name="base_link">
        <visual>
            <geometry>
                <cylinder length="0.2" radius="0.01"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
        </visual>
    </link>

    <link name="chassis">
        <visual>
            <geometry>
                <box size="0.985 0.406 0.03"/>
            </geometry>
            <material name="black2">
                <color rgba="0.05 0.05 0.05 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.985 0.406 0.03"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="30" />
            <inertia ixx="1.0"  ixy="0.0"   ixz="0.0"
                                iyy="1.0"   iyz="0.0"
                                            izz="1.0" />
        </inertial>
    </link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link" />
        <child link="chassis" />
        <origin xyz="0.3 0 0.1325" rpy="0 0 0"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder length="0.05" radius="0.1325"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.05" radius="0.1325"/>
            </geometry>
        </collision> 
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.500"/>
            <inertia ixx="0.0013541667" ixy="0" ixz="0" iyy="0.0013541667" iyz="0" izz="0.0025"/>
        </inertial>
    </link>

    

    <link name="right_wheel">
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.05" radius="0.1325"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.05" radius="0.1325"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.500"/>
            <inertia ixx="0.0013541667" ixy="0" ixz="0" iyy="0.0013541667" iyz="0" izz="0.0025"/>
        </inertial>
    </link>

    

    <link name="left_front_wheel">
        <collision>
            <geometry>
                <cylinder length="0.05" radius="0.1325"/>
            </geometry>
        </collision>
        <visual>
            <geometry>
                <cylinder length="0.05" radius="0.1325"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.0" />
            <inertia ixx="1.0"  ixy="0.0"   ixz="0.0"
                                iyy="1.0"   iyz="0.0"
                                            izz="1.0" />
        </inertial>
    </link>

    <joint name="left_front_wheel_joint" type="continuous">
        <parent link="chassis" />
        <child link="left_front_wheel" />
        <origin xyz="0.330 -0.235 0" rpy="-1.571 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <link name="right_front_wheel">
        <collision>
            <geometry>
                <cylinder length="0.05" radius="0.1325"/>
            </geometry>
        </collision>
        <visual>
            <geometry>
                <cylinder length="0.05" radius="0.1325"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.0" />
            <inertia ixx="1.0"  ixy="0.0"   ixz="0.0"
                                iyy="1.0"   iyz="0.0"
                                            izz="1.0" />
        </inertial>    
    </link>

    <joint name="right_front_wheel_joint" type="continuous">
        <parent link="chassis" />
        <child link="right_front_wheel"/>
        <origin xyz="0.330 0.235 0" rpy="-1.571 0 0" />
        <axis xyz="0 -1 0" />
    </joint>

    <link name="seat">
        <visual>
            <geometry>
                <box size="0.42 0.42 0.40"/>
            </geometry>
            <material name="black2">
                <color rgba="0.05 0.05 0.05 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.42 0.42 0.40"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="12" />
            <inertia ixx="1.0"  ixy="0.0"   ixz="0.0"
                                iyy="1.0"   iyz="0.0"
                                            izz="1.0" />
        </inertial>
    </link>

    <joint name="seat_joint" type="fixed">
        <parent link="chassis" />
        <child link="seat" />
        <origin xyz="-0.10 0 0.215" rpy="0 0 0"/>
    </joint>

    <link name="left_sensor_arm">
        <collision>
            <geometry>
                <cylinder length="0.11" radius="0.013"/>
            </geometry>
        </collision>
        <visual>
            <geometry>
                <cylinder length="0.11" radius="0.013"/>
            </geometry>
            <material name="black2">
                <color rgba="0.05 0.05 0.05 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="left_sensor_arm_joint" type="fixed">
        <parent link="seat"/>
        <child link="left_sensor_arm"/>
        <origin xyz="0.20 0.235 0.07" rpy="0 0 0"/>
    </joint>

    <link name="right_sensor_arm">
        <collision>
            <geometry>
                <cylinder length="0.11" radius="0.013"/>
            </geometry>
        </collision>
        <visual>
            <geometry>
                <cylinder length="0.11" radius="0.013"/>
            </geometry>
            <material name="black2">
                <color rgba="0.05 0.05 0.05 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="right_sensor_arm_joint" type="fixed">
        <parent link="seat"/>
        <child link="right_sensor_arm"/>
        <origin xyz="0.20 -0.235 0.07" rpy="0 0 0"/>
    </joint>

    <link name="backrest">
        <visual>
            <geometry>
                <box size="0.10 0.42 0.72"/>
            </geometry>
            <material name="black2">
                <color rgba="0.05 0.05 0.05 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.10 0.42 0.72"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="7" />
            <inertia ixx="1.0"  ixy="0.0"   ixz="0.0"
                                iyy="1.0"   iyz="0.0"
                                            izz="1.0" />
        </inertial>
    </link>

    <joint name="backrest_joint" type="fixed">
        <parent link="chassis" />
        <child link="backrest" />
        <origin xyz="-0.36 0 0.375" rpy="0 0 0"/>
    </joint>

    <link name="left_arm">
        <visual>
            <geometry>
                <box size="0.12 0.07 0.385"/>
            </geometry>
            <material name="black2">
                <color rgba="0.05 0.05 0.05 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.12 0.07 0.385"/>
            </geometry>
        </collision>
    </link>

    <joint name="left_arm_joint" type="fixed">
        <parent link="seat" />
        <child link="left_arm" />
        <origin xyz="0.2 0.245 0.20" rpy="0 1.0 0"/>
    </joint>

    <link name="left_arm_cover">
        <visual>
            <geometry>
                <box size="0.01 0.12 0.385"/>
            </geometry>
            <material name="white">
                <color rgba="0.9 0.9 0.9 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.01 0.12 0.385"/>
            </geometry>
        </collision>
    </link>
    
    <joint name="left_arm_cover_joint" type="fixed">
        <parent link="left_arm" />
        <child link="left_arm_cover" />
        <origin xyz="0 0.04 0" rpy="0 0 1.57"/>
    </joint>

    <link name="right_arm">
        <visual>
            <geometry>
                <box size="0.12 0.07 0.385"/>
            </geometry>
            <material name="black2">
                <color rgba="0.05 0.05 0.05 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.12 0.07 0.385"/>
            </geometry>
        </collision>
    </link>

    <joint name="right_arm_joint" type="fixed">
        <parent link="seat" />
        <child link="right_arm" />
        <origin xyz="0.2 -0.245 0.20" rpy="0 1.0 0"/>
    </joint>

    <link name="right_arm_cover">
        <visual>
            <geometry>
                <box size="0.01 0.12 0.385"/>
            </geometry>
            <material name="white">
                <color rgba="0.9 0.9 0.9 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.01 0.12 0.385"/>
            </geometry>
        </collision>
    </link>
    
    <joint name="right_arm_cover_joint" type="fixed">
        <parent link="right_arm" />
        <child link="right_arm_cover" />
        <origin xyz="0 -0.04 0" rpy="0 0 1.57"/>
    </joint>

    <!-- Sensor frame -->
    <link name="sensor_frame_left">
        <visual>
            <geometry>
                <box size="0.05 0.05 1.22"/>
            </geometry>
            <material name="white">
                <color rgba="0.9 0.9 0.9 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.05 1.22"/>
            </geometry>
        </collision>
    </link>

    <joint name="sensor_frame_left_joint" type="fixed">
        <parent link="chassis" />
        <child link="sensor_frame_left" />
        <origin xyz="-0.44 0.17 0.74" rpy="0 0 0"/>
    </joint>
    
    <link name="sensor_frame_right">
        <visual>
            <geometry>
                <box size="0.05 0.05 1.22"/>
            </geometry>
            <material name="white">
                <color rgba="0.9 0.9 0.9 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.05 1.22"/>
            </geometry>
        </collision>
    </link>

    <joint name="sensor_frame_right_joint" type="fixed">
        <parent link="chassis" />
        <child link="sensor_frame_right" />
        <origin xyz="-0.44 -0.17 0.74" rpy="0 0 0"/>
    </joint>

    <link name="sensor_frame_top">
        <visual>
            <geometry>
                <box size="0.05 0.34 0.05"/>
            </geometry>
            <material name="white">
                <color rgba="0.9 0.9 0.9 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.34 0.05"/>
            </geometry>
        </collision>
    </link>

    <joint name="sensor_frame_top_joint" type="fixed">
        <parent link="chassis" />
        <child link="sensor_frame_top" />
        <origin xyz="-0.44 0 1.325" rpy="0 0 0"/>
    </joint>

    <!-- Sensors -->
    <link name="lidar_sensor">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.0839" radius="0.043"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.0839" radius="0.043"/>
            </geometry>
        </collision>
    </link>

    <joint name="lidar_sensor_joint" type="fixed">
        <parent link="sensor_frame_top" />
        <child link="lidar_sensor" />
        <origin xyz="0 0 0.067" rpy="0 0 0"/>
    </joint>

    <link name="imu_sensor">
        <visual>
            <geometry>
                <box size="0.03 0.03 0.01"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.34 0.05"/>
            </geometry>
        </collision>
    </link>

    <joint name="imu_sensor_joint" type="fixed">
        <parent link="sensor_frame_top" />
        <child link="imu_sensor" />
        <origin xyz="0 -0.07 0.03" rpy="0 0 0"/>
    </joint>

    <gazebo reference="lidar_sensor">
        <sensor name="gpu_lidar" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <topic>lidar</topic>
            <update_rate>10</update_rate>
            <ray>
            <scan>
                <horizontal>
                <samples>640</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592</min_angle>
                <max_angle>3.141592</max_angle>
                </horizontal>
                <vertical>
                <samples>1</samples>
                <resolution>0.01</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
                </vertical>
            </scan>
            <range>
                <min>0.08</min>
                <max>10.0</max>
                <resolution>0.01</resolution>
            </range>
            </ray>
            <always_on>1</always_on>
            <visualize>true</visualize>
        </sensor>
    </gazebo>

    <gazebo reference="imu_sensor">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>1</update_rate>
            <visualize>true</visualize>
            <topic>imu</topic>
        </sensor>
    </gazebo>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="chassis" />
        <child link="left_wheel" />
        <origin xyz="-0.3 0.260 0.015" rpy="-1.571 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="chassis" />
        <child link="right_wheel" />
        <origin xyz="-0.3 -0.260 0.015" rpy="-1.571 0 0" />
        <axis xyz="0 -1 0" />
    </joint>

    <!-- Diff Drive Plugin -->
    <gazebo>
        <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.52</wheel_separation>
            <wheel_radius>0.1325</wheel_radius>
            <odom_publish_frequency>1</odom_publish_frequency>
            <topic>cmd_vel</topic>
        </plugin>
    </gazebo>
</robot>
