<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <joint name="$(arg prefix)camera_joint" type="fixed">
        <parent link="$(arg prefix)human_head_link"/>
        <child link="$(arg prefix)camera_link"/>
        <origin xyz="0.15 0 0.1" rpy="0 0 0"/>
    </joint>
    
    <link name="$(arg prefix)camera_link">
        <!-- <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.01 0.05 0.05"/>
            </geometry>
            <material name="sensor"/>
        </visual> -->
    </link>

    <joint name="$(arg prefix)camera_optical_joint" type="fixed">
        <parent link="$(arg prefix)camera_link"/>
        <child link="$(arg prefix)camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/> <!-- Z axis becomes depth(x-axis)-->
    </joint>

    <link name="$(arg prefix)camera_link_optical"></link>

    <gazebo reference="$(arg prefix)camera_link">
        <sensor type="camera" name="head_camera">
            <always_on>true</always_on>
            <update_rate>20</update_rate>
            <visualize>false</visualize>
            <camera name="head_camera">
                <horizontal_fov>1.2</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>800</width>
                    <height>600</height>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>300</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
                <distortion>
                    <k1>-0.25</k1>
                    <k2>0.12</k2>
                    <k3>0.0</k3>
                    <p1>0.0</p1>
                    <p2>0.0</p2>
                    <center>0.5 0.5</center>
                </distortion>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <imageTopicName>/head_camera/image_raw</imageTopicName>
                <cameraInfoTopicName>/head_camera/camera_info</cameraInfoTopicName>
                <cameraName>camera1</cameraName>
                <frameName>$(arg prefix)head_camera_link</frameName>
                <updateRate>10.0</updateRate>
                <CxPrime>0.0</CxPrime>
                <Cx>0.0</Cx>
                <Cy>0.0</Cy>
                <focalLength>0.0</focalLength> <!-- use computed_focal_length -->
                <hackBaseline>0.12</hackBaseline> <!-- use for P[3] -->
                <distortionK1>0.05</distortionK1>
                <distortionK2>-0.05</distortionK2>
                <distortionK3>0.0</distortionK3>
                <distortionT1>0.0</distortionT1>
                <distortionT2>0.0</distortionT2>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="$(arg prefix)camera_link">
        <material>Gazebo/DarkYellow</material>
    </gazebo>


</robot>