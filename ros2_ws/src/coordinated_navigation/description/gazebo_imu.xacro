<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <joint name="$(arg prefix)imu_sensor_joint" type="fixed">
        <parent link="$(arg prefix)sensor_frame_top"/>
        <child link="$(arg prefix)imu_sensor"/>
        <origin xyz="0 -0.07 0.03" rpy="0 0 0"/>
    </joint>

    <link name="$(arg prefix)imu_sensor">
        <visual>
            <geometry>
                <box size="0.03 0.03 0.01"/>
            </geometry>
            <material name="sensor"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.03 0.03 0.01"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.00001" x="0.03" y="0.03" z="0.01">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <gazebo reference="$(arg prefix)imu_sensor">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>1</update_rate>
            <visualize>true</visualize>
            <topic>imu</topic>
        </sensor>
    </gazebo>

    <gazebo reference="$(arg prefix)imu_sensor">
        <material>Gazebo/DarkYellow</material>
    </gazebo>
</robot>